# Copy to .env. Replace both passwords with different random values.
# Use at least 24 ASCII letters/digits (without quotes or $).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# By default, only a reverse proxy on the server can access the application.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# IP of the reverse proxy as seen from inside the web container.
TRUSTED_PROXY_IP=127.0.0.1

# Optional provider keys. Additional AI settings are described in README/docs.
AI_API_KEY=
DOCUMENT_ANALYSIS_API_KEY=
