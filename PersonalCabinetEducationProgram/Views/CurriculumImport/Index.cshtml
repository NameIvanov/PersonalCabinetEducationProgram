@model PersonalCabinetEducationProgram.ViewModels.CurriculumImportIndexViewModel
@{
    ViewData["Title"] = "Импорт учебного плана";
    var backController = User.IsInRole(AppRoles.Admin) ? "Admin" : "ManagerHome";
    var backAction = User.IsInRole(AppRoles.Admin) ? "ProgramDetails" : "Index";
    var backRouteName = User.IsInRole(AppRoles.Admin) ? "id" : "programId";
    var backRoute = new Dictionary<string, string> { [backRouteName] = Model.Program.Id.ToString() };
    string NextDirection(string column) => Model.Sort == column && Model.Direction == "asc" ? "desc" : "asc";
    Dictionary<string, string> ImportRoute(string sort, string direction, int page = 1)
    {
        var route = Model.Filters.ToRouteData();
        route["programId"] = Model.Program.Id.ToString();
        route["sort"] = sort;
        route["direction"] = direction;
        route["page"] = page.ToString();
        return route;
    }
}

<div class="container py-4">
    <a asp-controller="@backController" asp-action="@backAction" asp-all-route-data="@backRoute" class="text-decoration-none">← Назад к ОПОП</a>
    <div class="d-flex justify-content-between align-items-start gap-3 mt-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Импорт учебного плана</h3>
            <div class="text-muted">@Model.Program.CodeReferral @Model.Program.Name</div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["WarningMessage"] is string warningMessage)
    {
        <div class="alert alert-warning">@warningMessage</div>
    }

    <section class="border rounded-2 p-3 mb-4">
        <form asp-action="Preview" asp-route-programId="@Model.Program.Id" method="post" enctype="multipart/form-data">
            <input type="hidden" name="programId" value="@Model.Program.Id" />
            <label for="plxFile" class="form-label fw-semibold">Файл учебного плана</label>
            <div class="row g-3 align-items-center">
                <div class="col-12 col-lg-9">
                    <input id="plxFile" name="file" type="file" accept=".plx" class="form-control" required />
                </div>
                <div class="col-12 col-lg-3">
                    <button type="submit" class="btn btn-primary w-100 file-input-action">Предварительный просмотр</button>
                </div>
            </div>
            <div class="form-text">PLX, не более 20 МБ</div>
        </form>
    </section>

    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">История импортов</h4>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#importFilters">Поиск</button>
        </div>
        <form id="importFilters" method="get" class="collapse @(Model.Filters.HasAnyFilter ? "show" : "") border rounded-2 p-3 mb-3">
            <input type="hidden" name="programId" value="@Model.Program.Id" />
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input type="hidden" name="direction" value="@Model.Direction" />
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3"><label class="form-label small">Файл</label><input name="FileName" value="@Model.Filters.FileName" class="form-control form-control-sm" /></div>
                <div class="col-12 col-md-2"><label class="form-label small">Шифр плана</label><input name="PlanCode" value="@Model.Filters.PlanCode" class="form-control form-control-sm" /></div>
                <div class="col-12 col-md-3"><label class="form-label small">Автор</label><input name="Author" value="@Model.Filters.Author" class="form-control form-control-sm" /></div>
                <div class="col-6 col-md-2"><label class="form-label small">Дата от</label><input type="date" name="DateFrom" value="@Model.Filters.DateFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                <div class="col-6 col-md-2"><label class="form-label small">Дата до</label><input type="date" name="DateTo" value="@Model.Filters.DateTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                <div class="col-12 d-flex gap-2 justify-content-end"><button class="btn btn-primary btn-sm" type="submit">Найти</button><a asp-action="Index" asp-route-programId="@Model.Program.Id" class="btn btn-outline-secondary btn-sm">Сбросить</a></div>
            </div>
        </form>
        <div class="table-responsive border rounded-2">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("date", NextDirection("date"))">Дата</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("file", NextDirection("file"))">Файл</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("code", NextDirection("code"))">Шифр</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("author", NextDirection("author"))">Автор</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("created", NextDirection("created"))">Создано</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("updated", NextDirection("updated"))">Обновлено</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("archived", NextDirection("archived"))">В архив</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("skipped", NextDirection("skipped"))">Пропущено</a></th>
                        <th><a asp-action="Index" asp-all-route-data="@ImportRoute("warnings", NextDirection("warnings"))">Предупреждения</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var import in Model.Imports)
                    {
                        <tr>
                            <td class="text-nowrap">@import.ImportedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a asp-action="Download" asp-route-id="@import.Id">@import.OriginalFileName</a>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(import.PlanCode) ? "—" : import.PlanCode)</td>
                            <td>@import.ImportedByUser?.FullName</td>
                            <td>@import.CreatedCount</td>
                            <td>@import.UpdatedCount</td>
                            <td>@import.ArchivedCount</td>
                            <td>@import.SkippedCount</td>
                            <td>
                                @if (import.Warnings.Count > 0)
                                {
                                    <details>
                                        <summary>@import.Warnings.Count</summary>
                                        <ul class="mb-0 mt-2 ps-3 small">
                                            @foreach (var warning in import.Warnings)
                                            {
                                                <li>@warning</li>
                                            }
                                        </ul>
                                    </details>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Imports.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">Импортов пока не было</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3">
                <a asp-action="Index" asp-all-route-data="@ImportRoute(Model.Sort, Model.Direction, Model.Page - 1)" class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")">Назад</a>
                <span>@Model.Page из @Model.TotalPages</span>
                <a asp-action="Index" asp-all-route-data="@ImportRoute(Model.Sort, Model.Direction, Model.Page + 1)" class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")">Далее</a>
            </div>
        }
    </section>
</div>
