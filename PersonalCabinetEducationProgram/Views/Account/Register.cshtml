@model PersonalCabinetEducationProgram.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center">Регистрация</h3>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <form method="post" asp-action="Register">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Post" class="form-label"></label>
                                <input asp-for="Post" class="form-control" />
                                <span asp-validation-for="Post" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="RoleId" class="form-label"></label>
                                <select asp-for="RoleId" class="form-select">
                                    <option value="">Выберите роль</option>
                                    <option value="@PersonalCabinetEducationProgram.Models.AppRoles.ManagerId">Руководитель ОПОП</option>
                                    <option value="@PersonalCabinetEducationProgram.Models.AppRoles.ApproverId">Согласующий</option>
                                </select>
                                <span asp-validation-for="RoleId" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Username" class="form-label"></label>
                                <input asp-for="Username" class="form-control" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4">Зарегистрироваться</button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-decoration-none">У меня уже есть аккаунт</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
