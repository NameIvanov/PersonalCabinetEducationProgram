@{
    ViewData["Title"] = "История изменений";
    var element = ViewBag.Element as PersonalCabinetEducationProgram.Models.EducationalProgramElement;
    var history = ViewBag.History as List<PersonalCabinetEducationProgram.Models.ElementStatusHistory>;
    var comments = ViewBag.Comments as List<PersonalCabinetEducationProgram.Models.EducationalProgramElementComment>;
    var fileGroups = ViewBag.FileGroups as List<PersonalCabinetEducationProgram.Models.EducationalProgramElementFile> ?? new();
    var returnController = ViewBag.ReturnController as string ?? "ManagerHome";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-controller="@returnController" asp-action="Index" asp-route-programId="@element?.EducationalProgramId" class="text-decoration-none">← Назад к программе</a>
            <h4 class="fw-bold mt-2 mb-0">История: @element?.Name</h4>
            @if (!string.IsNullOrEmpty(element?.Description))
            {
                <div class="text-muted small">@element.Description</div>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom">
                    <h6 class="fw-bold mb-0">Изменения статуса</h6>
                </div>
                <div class="card-body">
                    @if (history != null && history.Any())
                    {
                        <div class="history-line">
                            @foreach (var h in history)
                            {
                                <div class="mb-3 position-relative">
                                    <div class="position-absolute" style="left:-22px;top:4px;width:12px;height:12px;border-radius:50%;background:#0d6efd;border:2px solid white;"></div>
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <span class="small fw-semibold">@h.User?.FullName</span>
                                            @if (!string.IsNullOrEmpty(h.OldStatus))
                                            {
                                                <span class="text-muted small"> изменил статус с «@h.OldStatus»</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"> установил статус «@h.NewStatus»</span>
                                            }
                                        </div>
                                        <div class="text-muted small" style="font-size:0.72rem;">@h.ChangeDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-secondary-subtle text-secondary">@h.NewStatus</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(h.Comment))
                                    {
                                        <div class="text-muted small mt-1 fst-italic">«@h.Comment»</div>
                                    }
                                    @if (!string.IsNullOrEmpty(h.FilePath))
                                    {
                                        <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
                                            <span class="small fw-semibold">@h.FileName</span>
                                            <a asp-controller="HistoryFiles" asp-action="Preview" asp-route-historyId="@h.Id"
                                               class="btn btn-outline-secondary btn-sm" target="_blank">Открыть</a>
                                            <a asp-controller="HistoryFiles" asp-action="Download" asp-route-historyId="@h.Id"
                                               class="btn btn-outline-secondary btn-sm">Скачать</a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <div>История изменений пуста</div>
                        </div>
                    }

                    @if (fileGroups.Any())
                    {
                        <hr class="my-4" />
                        <h6 class="fw-bold mb-3">Комплекты файлов</h6>
                        @foreach (var group in fileGroups.GroupBy(f => f.RevisionNumber).OrderByDescending(g => g.Key))
                        {
                            var isCurrent = group.Any(f => f.IsCurrent && !f.IsRemoved);
                            var submitted = group.Any(f => f.IsSubmitted);
                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold">Итерация @group.Key</span>
                                    <span class="badge @(isCurrent ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-secondary")">
                                        @(isCurrent ? (submitted ? "Текущая, зафиксирована" : "Текущая") : "Архив")
                                    </span>
                                </div>
                                @foreach (var file in group.OrderBy(f => f.IsRemoved).ThenBy(f => f.OriginalFileName))
                                {
                                    <div class="d-flex align-items-center justify-content-between gap-2 py-1">
                                        <span class="small text-truncate" title="@file.OriginalFileName">
                                            @file.OriginalFileName
                                            @if (file.IsRemoved)
                                            {
                                                <span class="badge bg-danger-subtle text-danger ms-1">Удалён из комплекта</span>
                                                <span class="text-muted">@file.RemovalReason</span>
                                            }
                                        </span>
                                        <span class="d-flex gap-1 flex-shrink-0">
                                            <a asp-controller="ElementFiles" asp-action="Preview" asp-route-id="@file.Id" class="btn btn-outline-secondary btn-sm" target="_blank">Открыть</a>
                                            <a asp-controller="ElementFiles" asp-action="Download" asp-route-id="@file.Id" class="btn btn-outline-secondary btn-sm">Скачать</a>
                                        </span>
                                    </div>
                                }
                                <div class="text-muted mt-2" style="font-size:.72rem;">
                                    @group.Min(f => f.UploadedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"), файлов: @group.Count()
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom">
                    <h6 class="fw-bold mb-0">Комментарии</h6>
                </div>
                <div class="card-body">
                    @if (comments != null && comments.Any())
                    {
                        @foreach (var c in comments)
                        {
                            <div class="comment-bubble mb-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-semibold">@c.User?.FullName</span>
                                    <span class="text-muted" style="font-size:0.7rem;">@c.DateTimeComment.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <div class="small">@c.CommentContent</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <div>Комментариев нет</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
