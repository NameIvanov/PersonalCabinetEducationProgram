@using PersonalCabinetEducationProgram.ViewModels
@model ManagerHomeViewModel
@{
	ViewData["Title"] = "Менеджер образовательных программ";
}

<div class="container-fluid bg-light min-vh-100 p-0 m-0">
	<div class="row g-0 m-0">
		<div class="col-12 col-lg-2 bg-white border-end min-vh-100 p-0 m-0">
			<div class="p-1 m-0">

				@if (Model.IsManager && Model.EducationalPrograms != null)
				{
					var directions = Model.EducationalPrograms
						.GroupBy(p => new { p.CodeReferral, p.Name })
						.ToList();
					<div class="accordion" id="sidebarDirections">
						@foreach (var dir in directions)
						{
							var dirKey = $"dir{Guid.NewGuid():N}";
							var programsInDir = dir.ToList();
							var deptIds = programsInDir
								.Select(p => Model.PinningDepartmentFaculties
									?.FirstOrDefault(pdf => pdf.EducationalProgramId == p.Id)?.DepartmentId)
								.Where(id => id.HasValue)
								.Select(id => id.Value)
								.Distinct()
								.ToList();
							<div class="accordion-item border-0">
								<h2 class="accordion-header">
									<button class="accordion-button bg-white shadow-none px-1 py-2 fw-semibold small" type="button"
									data-bs-toggle="collapse" data-bs-target="#@dirKey" aria-expanded="true">
										<span class="me-1">📘</span>
										<span>@dir.Key.CodeReferral "@dir.Key.Name"</span>
									</button>
								</h2>
								<div id="@dirKey" class="accordion-collapse collapse show">
									<div class="accordion-body p-0 pt-1 ps-3 d-grid gap-1">
										@foreach (var deptId in deptIds)
										{
											var dept = Model.Departments?.FirstOrDefault(d => d.Id == deptId);
											if (dept == null) { continue; }
											var deptKey = $"dept{Guid.NewGuid():N}";
											var progYears = programsInDir
												.Where(p => Model.PinningDepartmentFaculties
													?.Any(pdf => pdf.EducationalProgramId == p.Id && pdf.DepartmentId == deptId) == true)
												.Where(p => p.YearApprovals.HasValue)
												.Select(p => p.YearApprovals.Value.Year)
												.Distinct()
												.OrderByDescending(y => y)
												.ToList();
											<div class="accordion-item border-0">
												<h2 class="accordion-header">
													<button class="accordion-button bg-white shadow-none px-1 py-2 fw-normal small collapsed" type="button"
													data-bs-toggle="collapse" data-bs-target="#@deptKey">
														<span class="me-1">📂</span>
														<span>@dept.Name</span>
													</button>
												</h2>
												<div id="@deptKey" class="accordion-collapse collapse">
													<div class="accordion-body p-0 pt-1 ps-2 d-grid gap-1">
														@foreach (var y in progYears)
														{
															var isActive = y == Model.SelectedYear;
															<a href="?year=@y"
															   class="btn btn-sm text-start border rounded-3 py-1 px-2 @(isActive ? "btn-primary text-white fw-semibold" : "btn-light")">
																@y
															</a>
														}
													</div>
												</div>
											</div>
										}
									</div>
								</div>
							</div>
						}
					</div>
				}

				@if (Model.IsAdminOrStaff)
				{
					<div class="d-flex flex-column gap-2 p-2" id="navPanel">
						<a href="#" class="btn btn-outline-secondary text-start" data-panel="faculties">📋 Факультеты</a>
						<a href="#" class="btn btn-outline-secondary text-start" data-panel="departments">📋 Кафедры</a>
						<a href="#" class="btn btn-outline-secondary text-start" data-panel="users">👥 Сотрудники</a>
						<a href="#" class="btn btn-outline-secondary text-start" data-panel="programs">📘 ОПОП</a>
						<hr />
						<div id="panelContent">
							@if (Model.AllPrograms != null)
							{
								@foreach (var prog in Model.AllPrograms)
								{
									<a href="#" class="d-flex align-items-start text-decoration-none text-dark small mb-2 ps-0">
										<span class="me-1">›</span>
										<span>@prog.CodeReferral "@prog.Name"</span>
									</a>
								}
							}
						</div>
					</div>
				}

			</div>
		</div>

		<div class="col-12 col-lg-10 p-0 m-0">
			<div class="p-3 p-lg-4">
				<div class="row g-3">
					<div class="col-12 col-xl-5">
						<div class="card shadow-sm rounded-4 h-100">
							<div class="card-body p-4">
								@if (Model.CurrentProgram != null)
								{
									<h4 class="fw-bold mb-3">@Model.CurrentProgram.CodeReferral "@Model.CurrentProgram.Name"</h4>
									<p class="mb-4"><strong>Профиль:</strong> «@(Model.Departments?.FirstOrDefault()?.Name ?? "—")»</p>
									<div class="d-flex align-items-center gap-2">
										<span>Год начала подготовки:</span>
										<span class="badge rounded-pill text-dark border bg-white px-3 py-2">@(Model.CurrentProgram.YearApprovals?.Year.ToString() ?? "—")</span>
									</div>
								}
							</div>
						</div>
					</div>

					<div class="col-12 col-xl-7">
						<div class="card shadow-sm rounded-4 h-100">
							<div class="card-body p-4">
								<div class="row align-items-center">
									<div class="col-12 col-md-4 text-center mb-4 mb-md-0">
										<div class="d-inline-flex justify-content-center align-items-center rounded-circle border border-5 border-top border-start border-danger border-end border-primary border-bottom border-success"
										style="width:150px;height:150px;border-color:#e9ecef;">
											<div class="rounded-circle bg-white" style="width:95px;height:95px;"></div>
										</div>
									</div>

									<div class="col-12 col-md-8">
										<div class="table-responsive">
											<table class="table table-borderless align-middle mb-0">
												<thead>
													<tr class="text-muted">
														<th></th>
														<th>Дисциплины</th>
														<th>Практики</th>
														<th>ГИА</th>
														<th>Всего</th>
													</tr>
												</thead>
												<tbody>
													@{
														var stats = Model.GetStats();
														var rows = new[] {
															new { label = "Новые", badge = "bg-primary", key = "Новые" },
															new { label = "Согласовано", badge = "bg-secondary", key = "Согласовано" },
															new { label = "Не согласовано", badge = "bg-danger", key = "Не согласовано" },
															new { label = "На сайте", badge = "bg-success", key = "На сайте" }
														};
													}
													@foreach (var row in rows)
													{
														var vals = stats.ContainsKey(row.key) ? stats[row.key] : new[] { 0, 0, 0, 0 };
														<tr>
															<td><span class="badge rounded-circle @row.badge" style="width:10px;height:10px;">&nbsp;</span> @row.label</td>
															<td>@vals[0]</td>
															<td>@vals[1]</td>
															<td>@vals[2]</td>
															<td>@vals[3]</td>
														</tr>
													}
												</tbody>
											</table>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="mt-4">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h4 class="fw-bold mb-0">Редактор образовательной программы</h4>
						@if (Model.IsManager)
						{
							<a href="#" class="btn btn-primary">Добавить файл</a>
						}
					</div>
					<div class="card shadow-sm rounded-4">
						<div class="table-responsive">
							<table class="table table-hover align-middle mb-0">
								<thead class="table-light">
									<tr>
										<th>Элемент ОПОП</th>
										<th>Статус</th>
										<th>Дата загрузки</th>
										<th>Проверяющий</th>
										<th>Действия</th>
									</tr>
								</thead>
								<tbody>
									@if (Model.Elements != null)
									{
										@foreach (var item in Model.Elements)
										{
											<tr>
												<td>@(item.Name)</td>
												<td><span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">@(item.StatusApprovals)</span></td>
												<td>@(item.UploadDate)</td>
												<td>Проверяющий отсутствует</td>
												<td>
													<form method="post" enctype="multipart/form-data" asp-controller="ManagerHome" asp-action="Upload">
														<input type="hidden" name="elementId" value="2" />
														<div class="d-flex gap-2">
															<a href="#" class="btn btn-outline-secondary btn-sm">💬</a>
															<button type="submit" class="btn btn-outline-secondary btn-sm">✔️</button>
															<input type="file" name="file" class="btn btn-outline-secondary btn-sm" />
														</div>
													</form>
												</td>
											</tr>
										}
									}
									else
									{
										<h2>Нет товаров для отображения!</h2>
									}
								</tbody>
							</table>
						</div>
					</div>

					<div class="mt-4">
						<div class="card shadow-sm rounded-4">
							<div class="card-body p-2">
								<ul class="nav nav-pills gap-2" id="tabPills">
									<li class="nav-item"><a class="nav-link active" href="#" data-tab="disciplines">Дисциплины</a></li>
									<li class="nav-item"><a class="nav-link text-dark" href="#" data-tab="practice">Практика</a></li>
									<li class="nav-item"><a class="nav-link text-dark" href="#" data-tab="gia">ГИА</a></li>
									<li class="nav-item"><a class="nav-link text-dark" href="#" data-tab="materials">Методические материалы</a></li>
								</ul>
							</div>
						</div>
					</div>

					<div class="mt-3">
						<div id="tab-disciplines">
							<div class="card shadow-sm rounded-4">
								<div class="table-responsive">
									<table class="table table-hover align-middle mb-0">
										<thead class="table-light">
											<tr>
												<th>Шифр</th>
												<th>Наименование</th>
												<th>Статус</th>
												<th>Дата загрузки</th>
												<th>Проверяющий</th>
												<th>Действия</th>
											</tr>
										</thead>
										<tbody>
											@foreach(var item in Model.Elements.Where(i=>i.TypeElement=="Дисциплина"))
											{
												<tr>
													<td>Из таблицы ОПОП</td>
													<td>@(item.Name)</td>
													<td><span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle">На проверке</span></td>
													<td>@(item.UploadDate)</td>
													<td>Проверящий непонятно</td>
													<td>
														<form method="post" enctype="multipart/form-data" asp-controller="ManagerHome" asp-action="Upload">
															<input type="hidden" name="elementId" value="3" />
															<div class="d-flex gap-2">
																<a href="#" class="btn btn-outline-secondary btn-sm">💬</a>
																<button type="submit" class="btn btn-outline-secondary btn-sm">✔️</button>
																<input type="file" name="file" class="btn btn-outline-secondary btn-sm" />
															</div>
														</form>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>

						<div id="tab-practice" class="d-none">
							<div class="card shadow-sm rounded-4">
								<div class="table-responsive">
									<table class="table table-hover align-middle mb-0">
										<thead class="table-light">
											<tr>
												<th>Шифр</th>
												<th>Наименование</th>
												<th>Статус</th>
												<th>Дата загрузки</th>
												<th>Проверяющий</th>
												<th>Действия</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var item in Model.Elements.Where(i => i.TypeElement == "Практика"))
											{
												<tr>
													<td>Из таблицы ОПОП</td>
													<td>@(item.Name)</td>
													<td><span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle">На проверке</span></td>
													<td>@(item.UploadDate)</td>
													<td>Проверящий непонятно</td>
													<td>
														<form method="post" enctype="multipart/form-data" asp-controller="ManagerHome" asp-action="Upload">
															<input type="hidden" name="elementId" value="3" />
															<div class="d-flex gap-2">
																<a href="#" class="btn btn-outline-secondary btn-sm">💬</a>
																<button type="submit" class="btn btn-outline-secondary btn-sm">✔️</button>
																<input type="file" name="file" class="btn btn-outline-secondary btn-sm" />
															</div>
														</form>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>

						<div id="tab-gia" class="d-none">
							<div class="card shadow-sm rounded-4">
								<div class="table-responsive">
									<table class="table table-hover align-middle mb-0">
										<thead class="table-light">
											<tr>
												<th>Шифр</th>
												<th>Наименование</th>
												<th>Статус</th>
												<th>Дата загрузки</th>
												<th>Проверяющий</th>
												<th>Действия</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var item in Model.Elements.Where(i => i.TypeElement == "Программа ГИА"))
											{
												<tr>
													<td>Из таблицы ОПОП</td>
													<td>@(item.Name)</td>
													<td><span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle">На проверке</span></td>
													<td>@(item.UploadDate)</td>
													<td>Проверящий непонятно</td>
													<td>
														<form method="post" enctype="multipart/form-data" asp-controller="ManagerHome" asp-action="Upload">
															<input type="hidden" name="elementId" value="3" />
															<div class="d-flex gap-2">
																<a href="#" class="btn btn-outline-secondary btn-sm">💬</a>
																<button type="submit" class="btn btn-outline-secondary btn-sm">✔️</button>
																<input type="file" name="file" class="btn btn-outline-secondary btn-sm" />
															</div>
														</form>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>

						<div id="tab-materials" class="d-none">
							<div class="card shadow-sm rounded-4">
								<div class="table-responsive">
									<table class="table table-hover align-middle mb-0">
										<thead class="table-light">
											<tr>
												<th>Шифр</th>
												<th>Наименование</th>
												<th>Статус</th>
												<th>Дата загрузки</th>
												<th>Проверяющий</th>
												<th>Действия</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var item in Model.Elements.Where(i => i.TypeElement == "Методический материал"))
											{
												<tr>
													<td>Из таблицы ОПОП</td>
													<td>@(item.Name)</td>
													<td><span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle">На проверке</span></td>
													<td>@(item.UploadDate)</td>
													<td>Проверящий непонятно</td>
													<td>
														<form method="post" enctype="multipart/form-data" asp-controller="ManagerHome" asp-action="Upload">
															<input type="hidden" name="elementId" value="3" />
															<div class="d-flex gap-2">
																<a href="#" class="btn btn-outline-secondary btn-sm">💬</a>
																<button type="submit" class="btn btn-outline-secondary btn-sm">✔️</button>
																<input type="file" name="file" class="btn btn-outline-secondary btn-sm" />
															</div>
														</form>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		document.getElementById('tabPills').addEventListener('click', function (e) {
			const link = e.target.closest('.nav-link');
			if (!link) return;
			e.preventDefault();

			this.querySelectorAll('.nav-link').forEach(l => {
				l.classList.remove('active');
				l.classList.add('text-dark');
			});
			link.classList.add('active');
			link.classList.remove('text-dark');

			document.querySelectorAll('[id^="tab-"]').forEach(el => el.classList.add('d-none'));
			document.getElementById('tab-' + link.dataset.tab).classList.remove('d-none');
		});

		document.getElementById('navPanel')?.addEventListener('click', function (e) {
			const btn = e.target.closest('[data-panel]');
			if (!btn) return;
			e.preventDefault();

			this.querySelectorAll('[data-panel]').forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const panel = btn.dataset.panel;
			fetch('/ManagerHome/GetPanel?type=' + panel)
				.then(r => r.text())
				.then(html => document.getElementById('panelContent').innerHTML = html);
		});
	</script>
}