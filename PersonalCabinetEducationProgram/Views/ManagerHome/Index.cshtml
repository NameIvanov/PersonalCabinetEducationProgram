@model IEnumerable<PersonalCabinetEducationProgram.Models.EducationalProgramElement>
@{
    ViewData["Title"] = "Руководитель образовательной программы";

    var programs = ViewBag.Programs as List<PersonalCabinetEducationProgram.Models.EducationalProgram>;
    int? selectedProgramId = ViewBag.SelectedProgramId as int?;
    var selectedProgram = programs?.FirstOrDefault(p => p.Id == selectedProgramId);
    string activeTab = ViewBag.ActiveTab as string ?? "disciplines";
    var allComments = ViewBag.Comments as List<PersonalCabinetEducationProgram.Models.EducationalProgramElementComment>;
    var statusValues = ViewBag.ElementStatuses as List<string> ?? [];
    var elementPage = ViewBag.ElementPage as int? ?? 1; var elementTotalPages = ViewBag.ElementTotalPages as int? ?? 1;
    var elementSort = ViewBag.ElementSort as string ?? "name"; var elementDirection = ViewBag.ElementDirection as string ?? "asc";
    var elementFilters = ViewBag.ElementFilters as PersonalCabinetEducationProgram.ViewModels.ElementListFiltersViewModel ?? new();
    string NextDirection(string column) => elementSort == column && elementDirection == "asc" ? "desc" : "asc";
    Dictionary<string, string> ElementRouteData(string tabValue, int pageValue, string sortValue, string directionValue, bool includeMain = true, bool includeTab = true)
    {
        var values = elementFilters.ToRouteData(includeMain, includeTab);
        if (selectedProgramId.HasValue) values["programId"] = selectedProgramId.Value.ToString();
        values["tab"] = tabValue;
        values["page"] = pageValue.ToString();
        values["sort"] = sortValue;
        values["direction"] = directionValue;
        return values;
    }
    var mainFilterUi = new PersonalCabinetEducationProgram.ViewModels.ElementFilterUiViewModel
    {
        Filters = elementFilters,
        FormId = "managerMainFilterForm",
        PreservedRouteValues = ElementRouteData(activeTab, 1, elementSort, elementDirection, includeMain: false),
        ResetUrl = Url.Action("Index", ElementRouteData(activeTab, 1, elementSort, elementDirection, includeMain: false))!,
        IsMain = true
    };
    var tabFilterUi = new PersonalCabinetEducationProgram.ViewModels.ElementFilterUiViewModel
    {
        Filters = elementFilters,
        FormId = "managerTabFilterForm",
        PreservedRouteValues = ElementRouteData(activeTab, 1, elementSort, elementDirection, includeTab: false),
        ResetUrl = Url.Action("Index", ElementRouteData(activeTab, 1, elementSort, elementDirection, includeTab: false))!,
        IsMain = false
    };

    var mainElements = Model.Where(e => e.TypeElement == "Main").ToList();
    var disciplines = Model.Where(e => e.TypeElement == "Discipline").ToList();
    var practices = Model.Where(e => e.TypeElement == "Practice").ToList();
    var gia = Model.Where(e => e.TypeElement == "GIA").ToList();

    int countNew = statusValues.Count(s => string.IsNullOrEmpty(PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(s)));
    int countApproved = statusValues.Count(s => PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(s) == PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Approved);
    int countRejected = statusValues.Count(s => PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(s) == PersonalCabinetEducationProgram.Models.ElementApprovalStatus.RevisionRequired);
    int countOnReview = statusValues.Count(s => PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(s) == PersonalCabinetEducationProgram.Models.ElementApprovalStatus.OnApproval);
    int countUploaded = statusValues.Count(s => PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(s) == PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Uploaded);
    int countPublished = statusValues.Count(s => PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(s) == PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Published);
}

<div class="container-fluid p-0 m-0 app-shell">
    @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger m-3">@errorMessage</div> }
    <div class="row g-0 m-0">
        <div class="col-12 col-lg-2 app-sidebar">
            <div class="p-2">
                <div class="sidebar-title">Образовательные программы</div>

                @if (programs != null)
                {
                    var grouped = programs.GroupBy(p => p.EducationalLevel).OrderBy(g => g.Key);

                    foreach (var group in grouped)
                    {
                        var groupKey = group.Key?.Replace(" ", "") ?? "unknown";
                        var groupContainsSelected = group.Any(p => p.Id == selectedProgramId);
                        <div class="mb-1">
                            <div class="accordion" id="sidebar_@groupKey">
                                <div class="accordion-item border-0 bg-transparent">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button @(groupContainsSelected ? "" : "collapsed") bg-white shadow-none px-2 py-2 fw-semibold small"
                                                type="button" data-bs-toggle="collapse"
                                                data-bs-target="#collapse_@groupKey">
                                            @group.Key
                                        </button>
                                    </h2>
                                    <div id="collapse_@groupKey" class="accordion-collapse collapse @(groupContainsSelected ? "show" : "")" data-bs-parent="#sidebar_@groupKey">
                                        <div class="accordion-body p-0 ps-2">
                                            @foreach (var prog in group)
                                            {
                                                var assignment = prog.Assignments?.FirstOrDefault();
                                                <a asp-action="Index" asp-route-programId="@prog.Id"
                                                   class="d-block text-decoration-none py-1 px-2 rounded mb-1 sidebar-item @(prog.Id == selectedProgramId ? "active" : "")">
                                                    <div class="small fw-semibold text-dark">@prog.CodeReferral</div>
                                                    <div class="small text-muted app-small">@prog.Name</div>
                                                    @if (assignment?.Department != null)
                                                    {
                                                        <div class="text-muted app-caption">@assignment.Department.Name</div>
                                                    }
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-12 col-lg-10 p-0 app-content">
            <div class="p-3 p-lg-4">
                @if (selectedProgram != null)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-xl-5">
                            <div class="card shadow-sm rounded-4 h-100">
                                <div class="card-body p-4">
                                    <h4 class="fw-bold mb-2">@selectedProgram.CodeReferral «@selectedProgram.Name»</h4>
                                    @{ var assignment = selectedProgram.Assignments?.FirstOrDefault(); }
                                    @if (assignment != null)
                                    {
                                        <p class="mb-1"><strong>Кафедра:</strong> @assignment.Department?.Name</p>
                                        <p class="mb-1"><strong>Факультет:</strong> @assignment.Faculty?.Name</p>
                                    }
                                    <p class="mb-1"><strong>Уровень:</strong> @selectedProgram.EducationalLevel</p>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <span>Статус программы:</span>
                                        @{ var progStatusClass = selectedProgram.Status switch
                                            {
                                                 "Согласована" => "bg-success-subtle text-success",
                                                 "Опубликована" => "bg-primary-subtle text-primary",
                                                 "Требует доработки" => "bg-danger-subtle text-danger",
                                                 _ => "bg-warning-subtle text-warning"
                                            };
                                        }
                                        <span class="badge @progStatusClass">@selectedProgram.Status</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xl-7">
                            <div class="card shadow-sm rounded-4 h-100">
                                <div class="card-body p-4">
                                    <div class="row align-items-center">
                                        <div class="col-12 col-md-4 text-center mb-3 mb-md-0">
                                            @{
                                                double total = Math.Max(countNew + countApproved + countRejected + countOnReview + countUploaded + countPublished, 1);
                                                double pctNew = (countNew / total) * 100;
                                                double pctUploaded = (countUploaded / total) * 100;
                                                double pctApproved = (countApproved / total) * 100;
                                                double pctRejected = (countRejected / total) * 100;
                                                double pctOnReview = (countOnReview / total) * 100;
                                                double pctPublished = (countPublished / total) * 100;

                                                double stop1 = pctNew;
                                                double stop2 = stop1 + pctUploaded;
                                                double stop3 = stop2 + pctApproved;
                                                double stop4 = stop3 + pctRejected;
                                                double stop5 = stop4 + pctOnReview;
                                                double stop6 = stop5 + pctPublished;

                                                string chartStyle = "background: conic-gradient(" +
                                                    $"#6c757d 0% {stop1.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%, " +
                                                    $"#ffc107 {stop1.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}% {stop2.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%, " +
                                                    $"#198754 {stop2.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}% {stop3.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%, " +
                                                    $"#dc3545 {stop3.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}% {stop4.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%, " +
                                                    $"#0dcaf0 {stop4.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}% {stop5.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%, " +
                                                    $"#0d6efd {stop5.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}% {stop6.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%);";
                                            }
                                            <div class="position-relative d-inline-block rounded-circle" style="width:140px;height:140px;@chartStyle">
                                                <div class="position-absolute top-50 start-50 translate-middle rounded-circle bg-white d-flex flex-column align-items-center justify-content-center"
                                                     style="width:92px;height:92px;box-shadow: inset 0 0 0 1px rgba(0,0,0,.06);">
                                                    <div class="fw-bold fs-4">@statusValues.Count</div>
                                                    <div class="text-muted small">всего</div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-8">
                                            <table class="table table-borderless align-middle mb-0 small">
                                                <tbody>
                                                    <tr>
                                                        <td><span class="d-inline-block rounded-circle bg-secondary" style="width:10px;height:10px;"></span> Новые</td>
                                                        <td class="fw-bold">@countNew</td>
                                                        <td><span class="d-inline-block rounded-circle bg-warning" style="width:10px;height:10px;"></span> Загружено</td>
                                                        <td class="fw-bold">@countUploaded</td>
                                                    </tr>
                                                    <tr>
                                                        <td><span class="d-inline-block rounded-circle bg-success" style="width:10px;height:10px;"></span> Согласовано</td>
                                                        <td class="fw-bold">@countApproved</td>
                                                        <td><span class="d-inline-block rounded-circle bg-danger" style="width:10px;height:10px;"></span> На доработку</td>
                                                        <td class="fw-bold">@countRejected</td>
                                                    </tr>
                                                    <tr>
                                                        <td><span class="d-inline-block rounded-circle bg-info" style="width:10px;height:10px;"></span> На согласовании</td>
                                                        <td class="fw-bold">@countOnReview</td>
                                                        <td><span class="d-inline-block rounded-circle bg-primary" style="width:10px;height:10px;"></span> Опубликовано</td>
                                                        <td class="fw-bold">@countPublished</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm rounded-4 mb-4">
                        <div class="card-body py-5 text-center text-muted">
                            Для этого пользователя пока не назначено ни одной образовательной программы.
                        </div>
                    </div>
                }

                @if (selectedProgram != null)
                {
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0">Основные элементы ОПОП</h4>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle-element-filters
                                aria-expanded="@(elementFilters.ShowFilters || elementFilters.HasAnyFilter ? "true" : "false")">Поиск</button>
                    </div>
                    @await Html.PartialAsync("_ElementFilterForm", mainFilterUi)
                    <div class="card shadow-sm rounded-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Элемент ОПОП</th>
                                        <th>Статус</th>
                                        <th>Дата загрузки</th>
                                        <th>Действия</th>
                                    </tr>
                                    @await Html.PartialAsync("_ElementFilterRow", mainFilterUi)
                                </thead>
                                <tbody>
                                    @foreach (var element in mainElements)
                                    {
                                        await RenderElementRow(element, allComments);
                                    }
                                    @if (!mainElements.Any())
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-3">Элементы не найдены</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                            <ul class="nav nav-pills gap-1">
                                <li class="nav-item">
                                    <a class="nav-link tab-custom @(activeTab == "disciplines" ? "active" : "")"
                                       asp-action="Index" asp-all-route-data="@ElementRouteData("disciplines", 1, elementSort, elementDirection, includeTab: false)">Дисциплины</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link tab-custom @(activeTab == "practices" ? "active" : "")"
                                       asp-action="Index" asp-all-route-data="@ElementRouteData("practices", 1, elementSort, elementDirection, includeTab: false)">Практика</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link tab-custom @(activeTab == "gia" ? "active" : "")"
                                       asp-action="Index" asp-all-route-data="@ElementRouteData("gia", 1, elementSort, elementDirection, includeTab: false)">ГИА</a>
                                </li>
                            </ul>
                </div>

                @await Html.PartialAsync("_ElementFilterForm", tabFilterUi)
                <div class="card shadow-sm rounded-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th><a asp-action="Index" asp-all-route-data="@ElementRouteData(activeTab, 1, "description", NextDirection("description"))">Шифр</a></th>
                                    <th><a asp-action="Index" asp-all-route-data="@ElementRouteData(activeTab, 1, "name", NextDirection("name"))">Наименование</a></th>
                                    <th><a asp-action="Index" asp-all-route-data="@ElementRouteData(activeTab, 1, "status", NextDirection("status"))">Статус</a></th>
                                    <th><a asp-action="Index" asp-all-route-data="@ElementRouteData(activeTab, 1, "date", NextDirection("date"))">Дата загрузки</a></th>
                                    <th>Действия</th>
                                </tr>
                                @await Html.PartialAsync("_ElementFilterRow", tabFilterUi)
                            </thead>
                            <tbody>
                                @{
                                    var tabElements = activeTab switch
                                    {
                                        "practices" => practices,
                                        "gia" => gia,
                                        _ => disciplines
                                    };
                                }
                                @foreach (var element in tabElements)
                                {
                                    <tr>
                                        <td class="text-muted small">@element.Description</td>
                                        <td>@element.Name</td>
                                        <td>@await Html.PartialAsync("_StatusBadge", element.StatusApprovals)</td>
                                        <td class="small">@(element.UploadDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td>
                                            <div class="d-flex gap-1 flex-wrap">
                                                @await Html.PartialAsync("_ElementFileButtons", element)
                                                @if (PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(element.StatusApprovals) is PersonalCabinetEducationProgram.Models.ElementApprovalStatus.NotUploaded or PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Uploaded or PersonalCabinetEducationProgram.Models.ElementApprovalStatus.RevisionRequired)
                                                {
                                                    <form method="post" enctype="multipart/form-data" asp-controller="ManagerHome" asp-action="Upload" class="d-inline">
                                                        <input type="hidden" name="elementId" value="@element.Id" />
                                                        <label class="btn btn-outline-primary btn-sm mb-0" title="Прикрепить файлы">
                                                            📎 <input type="file" name="files" multiple accept=".pdf,.doc,.docx" data-max-size="52428800" title="До 20 файлов, каждый до 50 МБ" style="display:none;" onchange="if (window.validateUploadFile(this)) this.form.submit()" />
                                                        </label>
                                                    </form>
                                                }
                                                @if (PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(element.StatusApprovals) == PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Uploaded && element.Files.Any(f => f.IsCurrent))
                                                {
                                                    <form method="post" asp-action="SendForApproval" class="d-inline">
                                                        <input type="hidden" name="elementId" value="@element.Id" />
                                                        <button class="btn btn-outline-info btn-sm" type="submit" title="Зафиксировать группу и отправить на согласование">➤</button>
                                                    </form>
                                                }
                                                <a asp-action="Comments" asp-route-elementId="@element.Id" class="btn btn-outline-secondary btn-sm" title="Комментарии">💬</a>
                                                <a asp-action="History" asp-route-elementId="@element.Id" class="btn btn-outline-secondary btn-sm" title="История">🕐</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!tabElements.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">Элементы не найдены</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (elementTotalPages > 1)
                {
                    <div class="d-flex justify-content-between mt-3"><a asp-action="Index" asp-all-route-data="@ElementRouteData(activeTab, elementPage - 1, elementSort, elementDirection)" class="btn btn-outline-secondary @(elementPage <= 1 ? "disabled" : "")">Назад</a><span>@(elementPage) из @elementTotalPages</span><a asp-action="Index" asp-all-route-data="@ElementRouteData(activeTab, elementPage + 1, elementSort, elementDirection)" class="btn btn-outline-secondary @(elementPage >= elementTotalPages ? "disabled" : "")">Далее</a></div>
                }
                }
            </div>
        </div>
    </div>
</div>

@functions {
    async Task RenderElementRow(PersonalCabinetEducationProgram.Models.EducationalProgramElement element, List<PersonalCabinetEducationProgram.Models.EducationalProgramElementComment>? allComments)
    {
        var elementComments = allComments?.Where(c => c.EducationalProgramElementId == element.Id).ToList();
        var commentCount = elementComments?.Count ?? 0;

        <tr>
            <td>
                <div>@element.Name</div>
                @if (!string.IsNullOrEmpty(element.Description))
                {
                    <div class="text-muted small">@element.Description</div>
                }
            </td>
            <td>@await Html.PartialAsync("_StatusBadge", element.StatusApprovals)</td>
            <td class="small">@(element.UploadDate?.ToString("dd.MM.yyyy") ?? "—")</td>
            <td>
                <div class="d-flex gap-1 flex-wrap">
                    @await Html.PartialAsync("_ElementFileButtons", element)
                    @if (PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(element.StatusApprovals) is PersonalCabinetEducationProgram.Models.ElementApprovalStatus.NotUploaded or PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Uploaded or PersonalCabinetEducationProgram.Models.ElementApprovalStatus.RevisionRequired)
                    {
                        <form method="post" enctype="multipart/form-data" asp-controller="ManagerHome" asp-action="Upload" class="d-inline">
                            <input type="hidden" name="elementId" value="@element.Id" />
                            <label class="btn btn-outline-primary btn-sm mb-0" title="Прикрепить файлы">
                                📎 <input type="file" name="files" multiple accept=".pdf,.doc,.docx" data-max-size="52428800" title="До 20 файлов, каждый до 50 МБ" style="display:none;" onchange="if (window.validateUploadFile(this)) this.form.submit()" />
                            </label>
                        </form>
                    }
                    @if (PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Normalize(element.StatusApprovals) == PersonalCabinetEducationProgram.Models.ElementApprovalStatus.Uploaded && element.Files.Any(f => f.IsCurrent))
                    {
                        <form method="post" asp-action="SendForApproval" class="d-inline">
                            <input type="hidden" name="elementId" value="@element.Id" />
                            <button class="btn btn-outline-info btn-sm" type="submit" title="Зафиксировать группу и отправить на согласование">➤</button>
                        </form>
                    }
                    <a asp-action="Comments" asp-route-elementId="@element.Id" class="btn btn-outline-secondary btn-sm" title="Комментарии (@commentCount)">💬 @if (commentCount > 0) {<span>@commentCount</span>}</a>
                    <a asp-action="History" asp-route-elementId="@element.Id" class="btn btn-outline-secondary btn-sm" title="История">🕐</a>
                </div>
            </td>
        </tr>
    }
}
