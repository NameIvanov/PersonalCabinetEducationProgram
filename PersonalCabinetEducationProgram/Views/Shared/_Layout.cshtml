@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using PersonalCabinetEducationProgram.Data
@using PersonalCabinetEducationProgram.Models
@inject ApplicationDbContext DbContext
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isWorkflowPage = controller is "ManagerHome" or "ApproverHome" or "ModeratorHome";
    var showAppSidebar = isAuthenticated && !User.IsInRole("Admin") && !isWorkflowPage && controller != "Account";
    var preferredTheme = UserTheme.Light;

    if (isAuthenticated && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
    {
        preferredTheme = await DbContext.Users
            .AsNoTracking()
            .Where(user => user.Id == currentUserId)
            .Select(user => user.PreferredTheme)
            .SingleOrDefaultAsync() ?? UserTheme.Light;

        if (!UserTheme.IsValid(preferredTheme))
            preferredTheme = UserTheme.Light;
    }

    string ActiveLink(string targetController, string? targetAction = null)
    {
        var controllerMatches = controller.Equals(targetController, StringComparison.OrdinalIgnoreCase);
        var actionMatches = targetAction == null || action.Equals(targetAction, StringComparison.OrdinalIgnoreCase);
        return controllerMatches && actionMatches ? "active" : string.Empty;
    }
}
<!DOCTYPE html>
<html lang="ru" data-theme="@preferredTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Менеджер образовательных программ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <a class="app-brand" asp-controller="ManagerHome" asp-action="Index">
            <span class="app-brand-mark" aria-hidden="true">ОП</span>
            <span>Личный кабинет ОПОП</span>
        </a>

        @if (isAuthenticated && User.IsInRole("Admin"))
        {
            <nav class="admin-header-nav" aria-label="Разделы администратора">
                <a class="@ActiveLink("ManagerHome")" asp-controller="ManagerHome" asp-action="Index">Образовательные программы</a>
                <a class="@ActiveLink("ApproverHome")" asp-controller="ApproverHome" asp-action="Index">Согласование</a>
                <a class="@ActiveLink("ModeratorHome")" asp-controller="ModeratorHome" asp-action="Index">Публикация</a>
                <a class="@ActiveLink("Admin", "Programs")" asp-controller="Admin" asp-action="Programs">ОПОП</a>
                <a class="@ActiveLink("Admin", "Faculties")" asp-controller="Admin" asp-action="Faculties">Факультеты</a>
                <a class="@ActiveLink("Admin", "Departments")" asp-controller="Admin" asp-action="Departments">Кафедры</a>
                <a class="@ActiveLink("Admin", "Users")" asp-controller="Admin" asp-action="Users">Пользователи</a>
                <a class="@ActiveLink("Admin", "Assignments")" asp-controller="Admin" asp-action="Assignments">Назначения</a>
                <a class="@ActiveLink("Administration")" asp-controller="Administration" asp-action="Logs">Администрирование</a>
                <button id="assistantToggle" type="button" class="admin-ai-toggle" aria-controls="assistantWindow" aria-expanded="false">ИИ-помощник</button>
            </nav>
        }

        @if (isAuthenticated)
        {
            <div class="app-user">
                <form class="theme-preference-form" asp-controller="UserPreferences" asp-action="SetTheme" method="post" data-theme-form>
                    <input type="hidden" name="theme" value="@preferredTheme" data-theme-value />
                    <button type="button"
                            class="theme-toggle"
                            data-theme-toggle
                            aria-label="Переключить цветовую тему"
                            title="Переключить цветовую тему">
                        <span class="theme-toggle-option @(preferredTheme == UserTheme.Light ? "selected" : "")" data-theme-option="light" aria-hidden="true">☀</span>
                        <span class="theme-toggle-option @(preferredTheme == UserTheme.Dark ? "selected" : "")" data-theme-option="dark" aria-hidden="true">◐</span>
                    </button>
                </form>
                @await Component.InvokeAsync("NotificationBell")
                <span class="app-avatar" aria-hidden="true"></span>
                <div class="app-user-copy">
                    <strong>@User.Identity?.Name</strong>
                    <span>@User.FindFirst("Post")?.Value</span>
                </div>
                <form method="post" asp-controller="Account" asp-action="Logout">
                    <button type="submit" class="icon-button logout-button" title="Выйти" aria-label="Выйти">↗</button>
                </form>
            </div>
        }
    </header>

    <div class="site-shell @(showAppSidebar ? "with-navigation" : "")">
        @if (showAppSidebar)
        {
            <aside class="global-sidebar">
                <nav class="global-nav" aria-label="Основная навигация">
                    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <a class="@ActiveLink("ManagerHome")" asp-controller="ManagerHome" asp-action="Index">
                            <span class="nav-icon">▦</span><span>Образовательные программы</span>
                        </a>
                    }
                    @if (User.IsInRole("Approver") || User.IsInRole("Admin"))
                    {
                        <a class="@ActiveLink("ApproverHome")" asp-controller="ApproverHome" asp-action="Index">
                            <span class="nav-icon">✓</span><span>Согласование</span>
                        </a>
                    }
                    @if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
                    {
                        <a class="@ActiveLink("ModeratorHome")" asp-controller="ModeratorHome" asp-action="Index">
                            <span class="nav-icon">◎</span><span>Публикация</span>
                        </a>
                    }
                </nav>
            </aside>
        }

        <main role="main" class="site-content">
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">@errorMessage</div>
            }
            @RenderBody()
        </main>
    </div>

    @if (isAuthenticated && User.IsInRole("Admin"))
    {
        <partial name="_AdminAiAssistantWidget" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
