@model int

<a asp-controller="Notifications" asp-action="Index"
   class="notification-bell"
   title="Уведомления"
   aria-label="Уведомления, непрочитанных: @Model">
    <svg class="notification-bell-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" />
    </svg>
    @if (Model > 0)
    {
        <span class="notification-count">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
