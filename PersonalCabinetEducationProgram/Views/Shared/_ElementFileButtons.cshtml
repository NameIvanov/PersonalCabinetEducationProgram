@model PersonalCabinetEducationProgram.Models.EducationalProgramElement
@{
    var files = Model.Files.Where(f => f.IsCurrent && !f.IsRemoved).OrderBy(f => f.OriginalFileName).ToList();
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var combineFileActions = controllerName is "ApproverHome" or "ModeratorHome";
}

@if (combineFileActions && files.Count > 0)
{
    <div class="dropdown d-inline-block action-with-count">
        <button class="btn btn-outline-secondary btn-sm" type="button"
                data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" title="Файлы">
            Файлы
        </button>
        <span class="action-count badge rounded-pill bg-primary">@files.Count</span>
        <ul class="dropdown-menu dropdown-menu-end p-2 shadow-sm" style="min-width: 320px;">
            @foreach (var file in files)
            {
                <li class="d-flex align-items-center gap-2 mb-1 last-child-mb-0">
                    <span class="small text-truncate flex-grow-1" style="max-width: 220px;" title="@file.OriginalFileName">@file.OriginalFileName</span>
                    <a asp-controller="ElementFiles" asp-action="Preview" asp-route-id="@file.Id"
                       class="btn btn-outline-secondary btn-sm flex-shrink-0" title="Просмотр" target="_blank">📄</a>
                    <a asp-controller="ElementFiles" asp-action="Download" asp-route-id="@file.Id"
                       class="btn btn-outline-secondary btn-sm flex-shrink-0" title="Скачать">⬇</a>
                </li>
            }
        </ul>
    </div>
}
else if (files.Count == 1)
{
    <a asp-controller="ElementFiles" asp-action="Preview" asp-route-id="@files[0].Id"
       class="btn btn-outline-secondary btn-sm" title="Просмотр" target="_blank">📄</a>
    <a asp-controller="ElementFiles" asp-action="Download" asp-route-id="@files[0].Id"
       class="btn btn-outline-secondary btn-sm" title="Скачать">⬇</a>
}
else if (files.Count > 1)
{
    <div class="dropdown d-inline-block me-2">
        <button class="btn btn-outline-secondary btn-sm position-relative pe-4" type="button"
                data-bs-toggle="dropdown" title="Выбрать файл для просмотра">
            📄
            <span class="position-absolute top-0 end-0 mt-1 me-1 badge rounded-pill bg-primary">@files.Count</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            @foreach (var file in files)
            {
                <li><a class="dropdown-item small text-truncate" style="max-width:320px"
                       asp-controller="ElementFiles" asp-action="Preview" asp-route-id="@file.Id" target="_blank">@file.OriginalFileName</a></li>
            }
        </ul>
    </div>
    <div class="dropdown d-inline-block me-2">
        <button class="btn btn-outline-secondary btn-sm position-relative pe-4" type="button"
                data-bs-toggle="dropdown" title="Выбрать файл для скачивания">
            ⬇
            <span class="position-absolute top-0 end-0 mt-1 me-1 badge rounded-pill bg-primary">@files.Count</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            @foreach (var file in files)
            {
                <li><a class="dropdown-item small text-truncate" style="max-width:320px"
                       asp-controller="ElementFiles" asp-action="Download" asp-route-id="@file.Id">@file.OriginalFileName</a></li>
            }
        </ul>
    </div>
}
