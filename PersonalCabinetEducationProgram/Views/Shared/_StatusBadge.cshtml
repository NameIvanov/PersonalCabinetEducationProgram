@model string
@using PersonalCabinetEducationProgram.Models

@{
    var normalizedStatus = ElementApprovalStatus.Normalize(Model);
    var statusClass = normalizedStatus switch
    {
        ElementApprovalStatus.Uploaded => "bg-warning-subtle text-warning",
        ElementApprovalStatus.OnApproval => "bg-info-subtle text-info",
        ElementApprovalStatus.Approved => "bg-success-subtle text-success",
        ElementApprovalStatus.RevisionRequired => "bg-danger-subtle text-danger",
        ElementApprovalStatus.Published => "bg-primary-subtle text-primary",
        _ => "bg-secondary-subtle text-secondary"
    };
    var statusText = string.IsNullOrEmpty(normalizedStatus) ? "Не загружено" : normalizedStatus;
}

<span class="status-badge @statusClass d-inline-block">@statusText</span>
