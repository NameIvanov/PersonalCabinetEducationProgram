@model IEnumerable<PersonalCabinetEducationProgram.Models.Departments>
@using PersonalCabinetEducationProgram.ViewModels
@{
    ViewData["Title"] = "Кафедры";
    var approvers = ViewBag.Approvers as List<PersonalCabinetEducationProgram.Models.User>;
    var currentApprovers = ViewBag.CurrentApprovers as Dictionary<int, int> ?? new Dictionary<int, int>();
    var page = ViewBag.Page as int? ?? 1; var totalPages = ViewBag.TotalPages as int? ?? 1;
    var currentSort = ViewBag.Sort as string ?? "name"; var currentDirection = ViewBag.Direction as string ?? "asc";
    var filters = ViewBag.Filters as DepartmentListFiltersViewModel ?? new();
    const string filterFormId = "departmentsFilterForm";
    string NextDirection(string column) => currentSort == column && currentDirection == "asc" ? "desc" : "asc";
    Dictionary<string, string> RouteData(int targetPage, string targetSort, string targetDirection)
    {
        var values = filters.ToRouteData();
        values["page"] = targetPage.ToString(); values["sort"] = targetSort; values["direction"] = targetDirection;
        return values;
    }
    Dictionary<string, string> SortRoute(string column) => RouteData(1, column, NextDirection(column));
    Dictionary<string, string> PageRoute(int targetPage) => RouteData(targetPage, currentSort, currentDirection);
}

<div class="container py-4">
    @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">Кафедры</h4>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-toggle-live-filters aria-expanded="@(filters.ShowFilters || filters.HasAnyFilter)">Поиск</button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">Добавить кафедру</button>
        </div>
    </div>

    @await Html.PartialAsync("_LiveFilterForm", new LiveFilterFormViewModel
    {
        FormId = filterFormId,
        PreservedRouteValues = new Dictionary<string, string>
        {
            ["page"] = "1", ["sort"] = currentSort, ["direction"] = currentDirection, ["ShowFilters"] = "true"
        }
    })

    <div class="card shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th><a asp-action="Departments" asp-all-route-data="@SortRoute("id")">ID</a></th><th><a asp-action="Departments" asp-all-route-data="@SortRoute("code")">Код</a></th><th><a asp-action="Departments" asp-all-route-data="@SortRoute("name")">Наименование</a></th><th>Действия</th></tr>
                    <tr class="live-filter-row @((filters.ShowFilters || filters.HasAnyFilter) ? "" : "d-none")">
                        <th><input form="@filterFormId" type="number" min="1" name="Id" value="@filters.Id" class="form-control form-control-sm" placeholder="ID" /></th>
                        <th><input form="@filterFormId" type="search" name="Code" value="@filters.Code" class="form-control form-control-sm" placeholder="Код" /></th>
                        <th><input form="@filterFormId" type="search" name="Name" value="@filters.Name" class="form-control form-control-sm" placeholder="Наименование" /></th>
                        <th><a asp-action="Departments" asp-route-sort="@currentSort" asp-route-direction="@currentDirection" asp-route-ShowFilters="true" class="btn btn-outline-secondary btn-sm">Сбросить</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        var hasApprover = currentApprovers.TryGetValue(d.Id, out var currentApproverId);
                        <tr class="@(hasApprover ? "assignment-present" : "assignment-missing")">
                            <td>@d.Id</td>
                            <td>@d.CodeDepartment</td>
                            <td>
                                <a asp-action="DepartmentDetails" asp-route-id="@d.Id" class="text-decoration-none fw-semibold">
                                    @d.Name
                                </a>
                            </td>
                            <td>
                                <a asp-action="DepartmentDetails" asp-route-id="@d.Id" class="btn btn-outline-primary btn-sm">
                                    Открыть документы
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editDepartment_@d.Id">Изменить</button>
                                    <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#assignApproverDepartment_@d.Id">
                                        Назначить согласующего
                                    </button>
                                    <form method="post" asp-action="DeleteDepartment" class="d-inline" onsubmit="return confirm('Удалить кафедру?')"><input type="hidden" name="id" value="@d.Id" /><button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button></form>
                                }
                            </td>
                        </tr>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="modal fade" id="editDepartment_@d.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-action="EditDepartment"><div class="modal-header"><h5 class="modal-title">Изменить кафедру</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" value="@d.Id" /><div class="mb-3"><label class="form-label">Код</label><input name="codeDepartment" value="@d.CodeDepartment" class="form-control" required /></div><div class="mb-3"><label class="form-label">Наименование</label><input name="name" value="@d.Name" class="form-control" required /></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button><button type="submit" class="btn btn-primary">Сохранить</button></div></form></div></div></div>
                            <div class="modal fade" id="assignApproverDepartment_@d.Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content rounded-4">
                                        <form method="post" asp-action="AssignApproverToDepartment">
                                            <div class="modal-header"><h5 class="modal-title">Назначить согласующего кафедре</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                            <div class="modal-body">
                                                <input type="hidden" name="departmentId" value="@d.Id" />
                                                <div class="mb-1 fw-semibold">@d.Name</div>
                                                <div class="mb-3 text-muted small">@d.CodeDepartment</div>
                                                <div class="mb-3">
                                                    <label class="form-label">Согласующий</label>
                                                    <select name="approverUserId" class="form-select">
                                                        <option value="" selected="@(!hasApprover)">Не назначен</option>
                                                        @if (approvers != null)
                                                        {
                                                            @foreach (var approver in approvers)
                                                            {
                                                                <option value="@approver.Id" selected="@(currentApproverId == approver.Id)">@approver.FullName</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button><button type="submit" class="btn btn-success">Сохранить</button></div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1) { <div class="d-flex justify-content-between mt-3"><a asp-action="Departments" asp-all-route-data="@PageRoute(page - 1)" class="btn btn-outline-secondary @(page<=1?"disabled":"")">Назад</a><span>@(page) из @totalPages</span><a asp-action="Departments" asp-all-route-data="@PageRoute(page + 1)" class="btn btn-outline-secondary @(page>=totalPages?"disabled":"")">Далее</a></div> }

    <div class="modal fade" id="createModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content rounded-4">
                <form method="post" asp-action="CreateDepartment">
                    <div class="modal-header"><h5 class="modal-title">Новая кафедра</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <div class="mb-3"><label class="form-label">Код</label><input type="text" name="codeDepartment" class="form-control" required /></div>
                        <div class="mb-3"><label class="form-label">Наименование</label><input type="text" name="name" class="form-control" required /></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button><button type="submit" class="btn btn-primary">Создать</button></div>
                </form>
            </div>
        </div>
    </div>
</div>
