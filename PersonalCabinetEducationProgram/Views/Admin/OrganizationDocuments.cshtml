@model PersonalCabinetEducationProgram.ViewModels.OrganizationDocumentsViewModel
@using PersonalCabinetEducationProgram.ViewModels
@using PersonalCabinetEducationProgram.Models
@{
    ViewData["Title"] = Model.PageTitle;
    var filters = Model.Filters;
    var detailsAction = Model.EntityType == "Faculty" ? "FacultyDetails" : "DepartmentDetails";
    const string filterFormId = "organizationDocumentsFilterForm";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            @if (Model.EntityType == "Faculty")
            {
                <a asp-action="Faculties" class="text-decoration-none">← Назад к факультетам</a>
            }
            else
            {
                <a asp-action="Departments" class="text-decoration-none">← Назад к кафедрам</a>
            }
            <h3 class="fw-bold mt-2 mb-1">@Model.EntityName</h3>
            <div class="text-muted">@Model.PageTitle</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle-live-filters aria-expanded="@(filters.ShowFilters || filters.HasAnyFilter)">Поиск</button>
            <div class="badge bg-primary-subtle text-primary fs-6">ОПОП: @Model.Programs.Count</div>
        </div>
    </div>

    @await Html.PartialAsync("_LiveFilterForm", new LiveFilterFormViewModel
    {
        FormId = filterFormId,
        PreservedRouteValues = new Dictionary<string, string> { ["ShowFilters"] = "true" }
    })
    <div class="live-filter-panel live-filter-row @((filters.ShowFilters || filters.HasAnyFilter) ? "" : "d-none") mb-4">
        <div><label class="form-label small">ОПОП</label><input form="@filterFormId" type="search" name="Program" value="@filters.Program" class="form-control form-control-sm" placeholder="Шифр или название" /></div>
        <div><label class="form-label small">Тип</label><select form="@filterFormId" name="Type" class="form-select form-select-sm"><option value="">Все типы</option><option value="@EducationalProgramElementTypes.Main" selected="@(filters.Type == EducationalProgramElementTypes.Main)">Основные документы</option><option value="@EducationalProgramElementTypes.Discipline" selected="@(filters.Type == EducationalProgramElementTypes.Discipline)">Дисциплины</option><option value="@EducationalProgramElementTypes.Practice" selected="@(filters.Type == EducationalProgramElementTypes.Practice)">Практики</option><option value="@EducationalProgramElementTypes.Gia" selected="@(filters.Type == EducationalProgramElementTypes.Gia)">ГИА</option></select></div>
        <div><label class="form-label small">Документ</label><input form="@filterFormId" type="search" name="Name" value="@filters.Name" class="form-control form-control-sm" placeholder="Наименование" /></div>
        <div><label class="form-label small">Шифр / описание</label><input form="@filterFormId" type="search" name="Description" value="@filters.Description" class="form-control form-control-sm" placeholder="Шифр или описание" /></div>
        <div><label class="form-label small">Статус</label><select form="@filterFormId" name="Status" class="form-select form-select-sm"><option value="">Все статусы</option>@foreach (var status in ElementListFiltersViewModel.Statuses) { <option value="@status" selected="@(filters.Status == status)">@ElementListFiltersViewModel.GetStatusLabel(status)</option> }</select></div>
        <div><label class="form-label small">Дата загрузки</label><div class="d-flex gap-1 element-date-filter"><input form="@filterFormId" type="date" name="DateFrom" value="@filters.DateFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="Дата от" /><input form="@filterFormId" type="date" name="DateTo" value="@filters.DateTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="Дата до" /></div></div>
        <div class="d-flex align-items-end"><a asp-action="@detailsAction" asp-route-id="@Model.EntityId" asp-route-ShowFilters="true" class="btn btn-outline-secondary btn-sm">Сбросить</a></div>
    </div>

    @if (!Model.Programs.Any())
    {
        <div class="card shadow-sm rounded-4">
            <div class="card-body text-center text-muted py-5">
                Для этой сущности пока не привязано ни одной образовательной программы.
            </div>
        </div>
    }
    else
    {
        @foreach (var program in Model.Programs)
        {
            var assignment = program.Assignments?.FirstOrDefault(a =>
                (Model.EntityType == "Faculty" && a.FacultyId == Model.EntityId) ||
                (Model.EntityType == "Department" && a.DepartmentId == Model.EntityId));

            <div class="card shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-2">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                        <div>
                            <h5 class="fw-bold mb-1">@program.CodeReferral @program.Name</h5>
                            <div class="text-muted mb-1">@program.EducationalLevel</div>
                            <div class="small text-muted">
                                Кафедра: @(assignment?.Department?.Name ?? "—")
                            </div>
                            <div class="small text-muted">
                                Факультет: @(assignment?.Faculty?.Name ?? "—")
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary">Статус программы: @program.Status</span>
                        </div>
                    </div>
                </div>
                <div class="card-body px-0 pt-2 pb-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Тип</th>
                                    <th>Документ</th>
                                    <th>Шифр / описание</th>
                                    <th>Статус</th>
                                    <th>Дата загрузки</th>
                                    <th class="pe-4">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var element in program.Elements.OrderBy(e => e.TypeElement).ThenBy(e => e.Name))
                                {
                                    <tr>
                                        <td class="ps-4">@element.TypeElement</td>
                                        <td class="fw-semibold">@element.Name</td>
                                        <td class="text-muted small">@element.Description</td>
                                        <td>@await Html.PartialAsync("_StatusBadge", element.StatusApprovals)</td>
                                        <td>@(element.UploadDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td class="pe-4">
                                            <div class="d-flex gap-1 flex-wrap">
                                                <a asp-controller="ManagerHome" asp-action="Comments" asp-route-elementId="@element.Id" class="btn btn-outline-secondary btn-sm" title="Комментарии">💬</a>
                                                <a asp-controller="ManagerHome" asp-action="History" asp-route-elementId="@element.Id" class="btn btn-outline-secondary btn-sm" title="История">🕐</a>
                                                @await Html.PartialAsync("_ElementFileButtons", element)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>
