{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "FileStorageSettings": {
    "StoragePath": "D:\\2026",
    "BaseUrl": "/uploads/"
  },
  "TrustedProxies": {
    "ForwardLimit": 1,
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "SecurityMonitoring": {
    "AccountRiskBlockScore": 6,
    "AccountRiskWindowHours": 24,
    "HighSeverityRiskPoints": 1,
    "CriticalSeverityRiskPoints": 2,
    "IpRiskSuspiciousScore": 6,
    "IpRiskBlockScore": 15,
    "IpRiskWindowHours": 24,
    "IpRiskFirstBlockHours": 1,
    "IpRiskRepeatWindowDays": 7,
    "IpRiskSecondBlockHours": 24,
    "AnonymousProbeInitialThreshold": 3,
    "AnonymousProbeInitialWindowMinutes": 10,
    "AnonymousProbeFirstBlockMinutes": 30,
    "AnonymousProbeRepeatThreshold": 3,
    "AnonymousProbeEscalationWindowDays": 7,
    "AnonymousProbeSecondBlockHours": 24,
    "InvalidFileBlockThreshold": 5,
    "DownloadWarningThresholdPerMinute": 10,
    "DownloadBlockThresholdPerMinute": 20,
    "UserRequestWarningPerMinute": 100,
    "UserRequestWarningPerHour": 1000,
    "AnonymousIpRequestWarningPerMinute": 25,
    "AnonymousIpRequestWarningPerHour": 200,
    "AuthenticatedIpRequestWarningPerMinute": 300,
    "AuthenticatedIpRequestWarningPerHour": 5000,
    "LargeDocumentWarningBytes": 41943040,
    "LargeDocumentHighRiskBytes": 49807360,
    "LargeDocumentGroupWarningBytes": 157286400,
    "LargePlxWarningBytes": 5242880,
    "LargePlxHighRiskBytes": 10485760,
    "BlockNewForeignLogin": false,
    "ImpossibleTravelMinDistanceKm": 500,
    "ImpossibleTravelMaxSpeedKmh": 900,
    "NewNetworksWarningCount": 3,
    "NewNetworksWindowHours": 24,
    "FailedLoginCorrelationCount": 3,
    "FailedLoginCorrelationMinutes": 15,
    "ConcurrentSessionWindowMinutes": 30,
    "SessionActivityUpdateMinutes": 5,
    "SessionInactiveHours": 24,
    "IpGeolocation": {
      "Enabled": true,
      "AllowedCountryCode": "RU",
      "EndpointTemplate": "https://ipwho.is/{0}",
      "TimeoutMilliseconds": 2000,
      "CacheHours": 24,
      "FailureCacheMinutes": 15
    }
  }
}
